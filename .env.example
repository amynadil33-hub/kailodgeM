# Supabase — the site runs in labelled demo mode until these are set.
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key or the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Use the secret key or the legacy SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Comma-separated confirmed email addresses allowed to bootstrap owner access.
ADMIN_OWNER_EMAILS=kailodgemv@gmail.com

# Optional: absolute site URL used in booking links shared over WhatsApp
NEXT_PUBLIC_SITE_URL=

# Email notifications for contact and booking forms (Resend server-side API).
# CONTACT_EMAIL_TO defaults to kailodgemv@gmail.com when omitted.
RESEND_API_KEY=
CONTACT_EMAIL_TO=kailodgemv@gmail.com
# For testing, Resend allows onboarding@resend.dev. In production, use a sender on a verified domain.
EMAIL_FROM=Kai Lodge Website <onboarding@resend.dev>
