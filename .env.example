# Supabase — the site runs in labelled demo mode until these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for guest booking flows (availability, holds, private booking links).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: absolute site URL used in booking links shared over WhatsApp
NEXT_PUBLIC_SITE_URL=
